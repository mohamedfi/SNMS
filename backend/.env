# Application
APP_NAME="Steps Nursery Management System"
APP_ENV=local
APP_KEY=base64:oQTHes+4+fsTMhLPbWvkEiyf1YzH2Lh86Nvj0YVBJXc=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Frontend URLs (for CORS)
ADMIN_URL=http://localhost:5173
PARENT_URL=http://localhost:5174

# Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=snms
DB_USERNAME=postgres
DB_PASSWORD=

# Cache & Session
BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Redis (optional, for production)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@stepsnursery.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 / DigitalOcean Spaces (for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# For DigitalOcean Spaces:
# AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
# AWS_URL=https://your-bucket.nyc3.cdn.digitaloceanspaces.com

# Laravel Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174

# CORS Configuration
CORS_ALLOWED_ORIGINS="${ADMIN_URL},${PARENT_URL}"

# Payment Gateway - Paymob
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=

# Payment Gateway - Stripe (alternative)
STRIPE_KEY=
STRIPE_SECRET=

# WhatsApp API
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Monitoring (Sentry)
SENTRY_LARAVEL_DSN=

# Vite
VITE_APP_NAME="${APP_NAME}"
